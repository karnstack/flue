# Local development secrets. Copy to .dev.vars (gitignored) before `pnpm dev`.
# In production these are Worker secrets — `wrangler secret put NAME` — and
# never live in wrangler.jsonc.
#
# Generate a value: openssl rand -hex 32

# Keys the HMAC that login codes are stored under. Rotating it invalidates
# every outstanding code (they stop matching), which is the intended blast
# radius; it has no effect on existing sessions.
CODE_HMAC_SECRET=dev-only-not-a-real-secret

# Signs the channel tokens the relay verifies. THE SAME VALUE MUST BE SET ON
# THE RELAY WORKER (`cd relay && wrangler secret put RELAY_SIGNING_SECRET`):
# the relay authorizes a channel offline, by checking this signature and
# nothing else, so a mismatch means every bridge attempt is refused. Rotating
# it invalidates every outstanding channel token — they last 60s (browser) and
# 300s (daemon), so the blast radius is one TTL.
RELAY_SIGNING_SECRET=dev-only-not-a-real-secret

# The relay a channel token is addressed to, handed back with every token.
# Not a secret — it is public the moment a browser dials it — but it has no
# default on purpose: a hardcoded wss://relay.flue.sh would point a dev or
# self-hosted control plane at production.
RELAY_URL=ws://127.0.0.1:8787
