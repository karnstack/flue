{
  "main_module": "index.js",
  "compatibility_date": "2026-08-01",
  "bindings": [
    {
      "type": "durable_object_namespace",
      "name": "HUB",
      "class_name": "DaemonHub"
    },
    {
      "type": "ratelimit",
      "name": "CLIENT_RATE",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "type": "assets",
      "name": "ASSETS"
    }
  ],
  "keep_bindings": ["secret_text"],
  "migrations": {
    "new_tag": "v1",
    "steps": [
      {
        "new_sqlite_classes": ["DaemonHub"]
      }
    ]
  },
  "assets": {
    "jwt": "completion-token",
    "config": {
      "html_handling": "auto-trailing-slash",
      "not_found_handling": "single-page-application",
      "run_worker_first": ["/daemon", "/client", "/api/*"],
      "_headers": "/*\n  X-Fixture: yes\n"
    }
  },
  "observability": {
    "enabled": true
  }
}
