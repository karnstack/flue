{
  "name": "flue-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // One secret, not in this file — `wrangler secret put DAEMON_SECRET` only,
  // because anything written here is committed. It is the bearer secret the
  // daemon this relay serves shares with it; see spec/relay-protocol.md, Auth.
  //
  // A user's relay does not read this file at all — `flue relay setup` builds
  // its own deploy request in internal/relaydeploy and leaves that relay on
  // workers.dev: one daemon, one origin. This config exists for developing
  // the Worker itself (`pnpm dev`, the vitest pool).
  "assets": {
    // Response headers for these assets are NOT configurable here — wrangler's
    // schema rejects any key but the four below. They live in ./public/_headers,
    // which wrangler strips out of the upload and sends as a string in the
    // script metadata instead. `flue relay setup` sends the same document from
    // relayAssetHeaders (cmd/flue/relay.go, via internal/relaydeploy), and a test keeps the two byte for
    // byte identical; edit both or neither.
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The bare entries matter: "/daemon/*" alone would let the asset router
    // answer a bare /daemon with the SPA before the Worker's 404 could — the
    // Worker keeps refusal authority over its whole prefix, ids or not.
    // internal/relaydeploy (RunWorkerFirst) ships the same list in the
    // deploy request `flue relay setup` builds; edit both or neither.
    "run_worker_first": ["/daemon", "/daemon/*", "/client", "/client/*", "/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "DaemonHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DaemonHub"] }],
  // The per-IP bound on the credential-less routes (/client/*, POST
  // /api/pair/*): generous enough that a fleet of tabs never sees it, tight
  // enough that burning the daily request allowance needs a botnet
  // (spec/fleet-trust.md, "Rate rule"). internal/relaydeploy ships the same
  // binding — name, namespace, numbers — in the deploy request `flue relay
  // setup` builds; edit both or neither.
  "ratelimits": [
    { "name": "CLIENT_RATE", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
